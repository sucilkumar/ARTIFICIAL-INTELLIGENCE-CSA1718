        "from collections import deque\n",
        "\n",
        "def solve():\n",
        "    start = (3, 3, 1)\n",
        "    goal = (0, 0, 0)\n",
        "    q = deque([(start, [])])\n",
        "    visited = set()\n",
        "\n",
        "    moves = [(1, 0), (2, 0), (0, 1),\n",
        "             (0, 2), (1, 1)]\n",
        "\n",
        "    while q:\n",
        "        state, path = q.popleft()\n",
        "        m, c, boat = state\n",
        "\n",
        "        if state == goal:\n",
        "            for s in path + [state]:\n",
        "                print(s)\n",
        "            return\n",
        "\n",
        "        if state in visited:\n",
        "            continue\n",
        "        visited.add(state)\n",
        "\n",
        "        for dm, dc in moves:\n",
        "            if boat == 1:\n",
        "                nm, nc = m - dm, c - dc\n",
        "                nb = 0\n",
        "            else:\n",
        "                nm, nc = m + dm, c + dc\n",
        "                nb = 1\n",
        "\n",
        "            if 0 <= nm <= 3 and 0 <= nc <= 3:\n",
        "                if (nm == 0 or nm >= nc) and \\\n",
        "                   (3 - nm == 0 or 3 - nm >= 3 - nc):\n",
        "                    q.append(((nm, nc, nb), path + [state]))\n",
        "\n",
        "solve()"
