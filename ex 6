      "source": [
        "room = {'A': 1, 'B': 1}\n",
        "pos = 'A'\n",
        "\n",
        "while 1 in room.values():\n",
        "    print(\"Vacuum at\", pos)\n",
        "\n",
        "    if room[pos] == 1:\n",
        "        room[pos] = 0\n",
        "        print(\"Room\", pos, \"cleaned\")\n",
        "\n",
        "    else:\n",
        "        pos = 'B' if pos == 'A' else 'A'\n",
        "\n",
        "print(\"All rooms are clean\")"
