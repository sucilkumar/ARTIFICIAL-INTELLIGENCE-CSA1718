        "\n",
        "import math\n",
        "from collections import Counter\n",
        "from pprint import pprint\n",
        "\n",
        "# Play Tennis dataset\n",
        "data = [\n",
        "    ['Sunny', 'Hot', 'High', 'Weak', 'No'],\n",
        "    ['Sunny', 'Hot', 'High', 'Strong', 'No'],\n",
        "    ['Overcast', 'Hot', 'High', 'Weak', 'Yes'],\n",
        "    ['Rain', 'Mild', 'High', 'Weak', 'Yes'],\n",
        "    ['Rain', 'Cool', 'Normal', 'Weak', 'Yes'],\n",
        "    ['Rain', 'Cool', 'Normal', 'Strong', 'No'],\n",
        "    ['Overcast', 'Cool', 'Normal', 'Strong', 'Yes'],\n",
        "    ['Sunny', 'Mild', 'High', 'Weak', 'No'],\n",
        "    ['Sunny', 'Cool', 'Normal', 'Weak', 'Yes'],\n",
        "    ['Rain', 'Mild', 'Normal', 'Weak', 'Yes'],\n",
        "    ['Sunny', 'Mild', 'Normal', 'Strong', 'Yes'],\n",
        "    ['Overcast', 'Mild', 'High', 'Strong', 'Yes'],\n",
        "    ['Overcast', 'Hot', 'Normal', 'Weak', 'Yes'],\n",
        "    ['Rain', 'Mild', 'High', 'Strong', 'No']\n",
        "]\n",
        "\n",
        "features = ['Outlook', 'Temperature', 'Humidity', 'Wind']\n",
        "target_index = 4\n",
        "\n",
        "\n",
        "# Calculate entropy\n",
        "def entropy(rows):\n",
        "    total = len(rows)\n",
        "    counts = Counter(row[target_index] for row in rows)\n",
        "\n",
        "    result = 0\n",
        "    for count in counts.values():\n",
        "        p = count / total\n",
        "        result -= p * math.log2(p)\n",
        "\n",
        "    return result\n",
        "\n",
        "\n",
        "# Calculate information gain\n",
        "def information_gain(rows, feature_index):\n",
        "    total_entropy = entropy(rows)\n",
        "    values = set(row[feature_index] for row in rows)\n",
        "\n",
        "    weighted_entropy = 0\n",
        "    for value in values:\n",
        "        subset = [\n",
        "            row for row in rows\n",
        "            if row[feature_index] == value\n",
        "        ]\n",
        "        weighted_entropy += (\n",
        "            len(subset) / len(rows)\n",
        "        ) * entropy(subset)\n",
        "\n",
        "    return total_entropy - weighted_entropy\n",
        "\n",
        "\n",
        "# Build decision tree using ID3\n",
        "def build_tree(rows, available_features):\n",
        "    labels = [row[target_index] for row in rows]\n",
        "\n",
        "    # If all examples have the same class\n",
        "    if len(set(labels)) == 1:\n",
        "        return labels[0]\n",
        "\n",
        "    # If no features remain, return majority class\n",
        "    if not available_features:\n",
        "        return Counter(labels).most_common(1)[0][0]\n",
        "\n",
        "    # Select feature with maximum information gain\n",
        "    best_feature = max(\n",
        "        available_features,\n",
        "        key=lambda f: information_gain(\n",
        "            rows, features.index(f)\n",
        "        )\n",
        "    )\n",
        "\n",
        "    tree = {best_feature: {}}\n",
        "    feature_index = features.index(best_feature)\n",
        "\n",
        "    for value in set(row[feature_index] for row in rows):\n",
        "        subset = [\n",
        "            row for row in rows\n",
        "            if row[feature_index] == value\n",
        "        ]\n",
        "\n",
        "        tree[best_feature][value] = build_tree(\n",
        "            subset,\n",
        "            [f for f in available_features\n",
        "             if f != best_feature]\n",
        "        )\n",
        "\n",
        "    return tree\n",
        "\n",
        "\n",
        "# Predict class for a new example\n",
        "def predict(tree, example):\n",
        "    if not isinstance(tree, dict):\n",
        "        return tree\n",
        "\n",
        "    feature = next(iter(tree))\n",
        "    value = example[features.index(feature)]\n",
        "\n",
        "    if value not in tree[feature]:\n",
        "        return \"Unknown\"\n",
        "\n",
        "    return predict(tree[feature][value], example)\n",
        "\n",
        "\n",
        "# Main program\n",
        "decision_tree = build_tree(data, features)\n",
        "\n",
        "print(\"Decision Tree:\")\n",
        "pprint(decision_tree)\n",
        "\n",
        "# Test a new example:\n",
        "# Outlook, Temperature, Humidity, Wind\n",
        "new_example = ['Sunny', 'Cool', 'High', 'Strong']\n",
        "\n",
        "print(\"\\nNew Example:\", new_example)\n",
        "print(\"Prediction:\", predict(decision_tree, new_example))\n"
      ],
