      "source": [
        "from itertools import permutations\n",
        "\n",
        "dist = [\n",
        "    [0, 10, 15, 20],\n",
        "    [10, 0, 35, 25],\n",
        "    [15, 35, 0, 30],\n",
        "    [20, 25, 30, 0]\n",
        "]\n",
        "\n",
        "n = len(dist)\n",
        "min_cost = float('inf')\n",
        "\n",
        "for p in permutations(range(1, n)):\n",
        "    path = (0,) + p + (0,)\n",
        "    cost = sum(dist[path[i]][path[i+1]]\n",
        "               for i in range(n))\n",
        "\n",
        "    if cost < min_cost:\n",
        "        min_cost = cost\n",
        "        best_path = path\n",
        "\n",
        "print(\"Shortest Path:\", best_path)\n",
        "print(\"Minimum Cost:\", min_cost)"
      ],
