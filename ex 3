      "source": [
        "from collections import deque\n",
        "\n",
        "goal = (1, 2, 3, 4, 5, 6, 7, 8, 0)\n",
        "\n",
        "def solve(start):\n",
        "    q = deque([(start, [])])\n",
        "    visited = {start}\n",
        "\n",
        "    while q:\n",
        "        state, path = q.popleft()\n",
        "\n",
        "        if state == goal:\n",
        "            return path + [state]\n",
        "\n",
        "        zero = state.index(0)\n",
        "\n",
        "        for move in [-3, 3, -1, 1]:\n",
        "            new = zero + move\n",
        "\n",
        "            if 0 <= new < 9:\n",
        "                if abs(move) == 1 and zero // 3 != new // 3:\n",
        "                    continue\n",
        "\n",
        "                s = list(state)\n",
        "                s[zero], s[new] = s[new], s[zero]\n",
        "                s = tuple(s)\n",
        "\n",
        "                if s not in visited:\n",
        "                    visited.add(s)\n",
        "                    q.append((s, path + [state]))\n",
        "\n",
        "    return None\n",
        "\n",
        "start = tuple(map(int, input(\"Enter 9 numbers (0 for blank): \").split()))\n",
        "result = solve(start)\n",
        "\n",
        "if result:\n",
        "    for state in result:\n",
        "        for i in range(0, 9, 3):\n",
        "            print(state[i:i+3])\n",
        "        print()\n",
        "else:\n",
        "    print(\"No solution\")"
