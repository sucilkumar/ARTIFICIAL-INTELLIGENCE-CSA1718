      "source": [
        "\n",
        "import numpy as np\n",
        "\n",
        "# Input data for XOR\n",
        "X = np.array([\n",
        "    [0, 0],\n",
        "    [0, 1],\n",
        "    [1, 0],\n",
        "    [1, 1]\n",
        "])\n",
        "\n",
        "# Expected output\n",
        "Y = np.array([\n",
        "    [0],\n",
        "    [1],\n",
        "    [1],\n",
        "    [0]\n",
        "])\n",
        "\n",
        "# Initialize weights and biases\n",
        "np.random.seed(42)\n",
        "\n",
        "W1 = np.random.randn(2, 4)\n",
        "b1 = np.zeros((1, 4))\n",
        "\n",
        "W2 = np.random.randn(4, 1)\n",
        "b2 = np.zeros((1, 1))\n",
        "\n",
        "learning_rate = 0.5\n",
        "epochs = 10000\n",
        "\n",
        "\n",
        "# Sigmoid activation function\n",
        "def sigmoid(x):\n",
        "    return 1 / (1 + np.exp(-x))\n",
        "\n",
        "\n",
        "# Derivative of sigmoid\n",
        "def sigmoid_derivative(x):\n",
        "    return x * (1 - x)\n",
        "\n",
        "\n",
        "# Training the neural network\n",
        "for epoch in range(epochs):\n",
        "\n",
        "    # Forward propagation\n",
        "    hidden_input = np.dot(X, W1) + b1\n",
        "    hidden_output = sigmoid(hidden_input)\n",
        "\n",
        "    final_input = np.dot(hidden_output, W2) + b2\n",
        "    predicted_output = sigmoid(final_input)\n",
        "\n",
        "    # Calculate error\n",
        "    error = Y - predicted_output\n",
        "\n",
        "    # Backpropagation\n",
        "    d_output = error * sigmoid_derivative(predicted_output)\n",
        "    d_hidden = np.dot(d_output, W2.T) * sigmoid_derivative(hidden_output)\n",
        "\n",
        "    # Update weights and biases\n",
        "    W2 += learning_rate * np.dot(hidden_output.T, d_output)\n",
        "    b2 += learning_rate * np.sum(d_output, axis=0, keepdims=True)\n",
        "\n",
        "    W1 += learning_rate * np.dot(X.T, d_hidden)\n",
        "    b1 += learning_rate * np.sum(d_hidden, axis=0, keepdims=True)\n",
        "\n",
        "\n",
        "# Test the trained network\n",
        "print(\"Feed Forward Neural Network - XOR\")\n",
        "print(\"\\nInput\\t\\tPredicted Output\")\n",
        "\n",
        "for i in range(len(X)):\n",
        "    hidden = sigmoid(np.dot(X[i:i+1], W1) + b1)\n",
        "    output = sigmoid(np.dot(hidden, W2) + b2)\n",
        "\n",
        "    print(X[i], \"\\t\", round(output[0, 0], 4))\n",
        "    print(\"Predicted class:\", round(output[0, 0]))\n"
      ],
