      "source": [
        "\n",
        "# Map Coloring Problem using CSP and Backtracking\n",
        "\n",
        "# Define the map regions\n",
        "regions = ['A', 'B', 'C', 'D']\n",
        "\n",
        "# Define adjacent regions (constraints)\n",
        "neighbors = {\n",
        "    'A': ['B', 'C'],\n",
        "    'B': ['A', 'C', 'D'],\n",
        "    'C': ['A', 'B', 'D'],\n",
        "    'D': ['B', 'C']\n",
        "}\n",
        "\n",
        "# Available colors\n",
        "colors = ['Red', 'Green', 'Blue']\n",
        "\n",
        "# Store assigned colors\n",
        "color_assignment = {}\n",
        "\n",
        "\n",
        "# Check whether a color is valid\n",
        "def is_valid(region, color):\n",
        "    for neighbor in neighbors[region]:\n",
        "        if neighbor in color_assignment:\n",
        "            if color_assignment[neighbor] == color:\n",
        "                return False\n",
        "    return True\n",
        "\n",
        "\n",
        "# Solve CSP using backtracking\n",
        "def solve():\n",
        "    if len(color_assignment) == len(regions):\n",
        "        return True\n",
        "\n",
        "    # Select an uncolored region\n",
        "    for region in regions:\n",
        "        if region not in color_assignment:\n",
        "            break\n",
        "\n",
        "    # Try each available color\n",
        "    for color in colors:\n",
        "        if is_valid(region, color):\n",
        "            color_assignment[region] = color\n",
        "\n",
        "            if solve():\n",
        "                return True\n",
        "\n",
        "            # Backtrack\n",
        "            del color_assignment[region]\n",
        "\n",
        "    return False\n",
        "\n",
        "\n",
        "# Main program\n",
        "if solve():\n",
        "    print(\"Map Coloring Solution:\")\n",
        "    for region, color in color_assignment.items():\n",
        "        print(region, \":\", color)\n",
        "else:\n",
        "    print(\"No solution exists.\")\n"
      ]
    }
