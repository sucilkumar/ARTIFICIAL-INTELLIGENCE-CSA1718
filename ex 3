      "source": [
        "from collections import deque\n",
        "\n",
        "def water_jug(a, b, target):\n",
        "    q = deque([(0, 0)])\n",
        "    visited = set()\n",
        "\n",
        "    while q:\n",
        "        x, y = q.popleft()\n",
        "\n",
        "        if (x, y) in visited:\n",
        "            continue\n",
        "\n",
        "        visited.add((x, y))\n",
        "        print(x, y)\n",
        "\n",
        "        if x == target or y == target:\n",
        "            print(\"Target reached!\")\n",
        "            return\n",
        "\n",
        "        q.append((a, y))       # Fill jug A\n",
        "        q.append((x, b))       # Fill jug B\n",
        "        q.append((0, y))       # Empty jug A\n",
        "        q.append((x, 0))       # Empty jug B\n",
        "\n",
        "        pour = min(x, b - y)\n",
        "        q.append((x - pour, y + pour))  # Pour A to B\n",
        "\n",
        "        pour = min(y, a - x)\n",
        "        q.append((x + pour, y - pour))  # Pour B to A\n",
        "\n",
        "    print(\"Solution not possible\")\n",
        "\n",
        "water_jug(4, 3, 2)"
      ],
